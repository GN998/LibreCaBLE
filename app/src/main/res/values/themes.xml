<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Configure translucent window by default for zero-flicker QR bottom-sheet launches; launcher mode restores opacity at runtime -->
    <style name="Theme.PasskeyBridge" parent="Theme.AppCompat">
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryDark">#020617</item>
        <item name="colorAccent">@android:color/system_accent1_300</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>